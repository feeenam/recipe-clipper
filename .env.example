# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Vercel can fill it for you: `npx vercel@latest env pull .env.local` (Sensitive vars come back empty).

# Frontend (Vite) and serverless functions (api/extract-recipe.ts)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret used by api/delete-recipe.ts (recipe deletion) and the local backfill scripts. Supabase dashboard >
# Project Settings > API > service_role. NEVER prefix with VITE_ or it would ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Serverless function (api/extract-recipe.ts, api/admin-status.ts)
GEMINI_API_KEY=your-gemini-api-key

# Serverless functions (api/extract-recipe.ts fallback, api/voice-assistant.ts [admin only], api/admin-status.ts)
GROQ_API_KEY=your-groq-api-key

# Cloudflare Turnstile SITE key (public). Supabase CAPTCHA protection is on, so every sign-in needs a
# Turnstile token. The matching SECRET key goes only in Supabase: Auth > Attack Protection.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional: email shown as "Request an invite" on the login page. Hidden when unset.
VITE_INVITE_EMAIL=

# Admin login for /admin (api/admin-login.ts, api/admin-status.ts, api/delete-recipe.ts)
ADMIN_PASSWORD=choose-a-strong-password
